# APP_URL: Public base URL of the deployed LinkVault app (used for PicLinks and Telegram webhook).
APP_URL="http://localhost:3000"

# ADMIN_PASSWORD: Server-side password protecting the hidden /admin panel.
# If left empty, a one-time first-run admin setup form lets you claim the password safely.
ADMIN_PASSWORD=""

# CLICK_HMAC_SECRET: Server-side signing secret for click verification tokens and admin sessions.
# Generate a strong random 32+ byte secret in Cloudflare Pages / deployment environment variables.
CLICK_HMAC_SECRET=""

# TELEGRAM_BOT_TOKEN: Optional override for Telegram Bot API token (can also be configured in /admin).
TELEGRAM_BOT_TOKEN=""
